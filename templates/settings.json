{
  "worktree": { "baseRef": "head" },
  "attribution": { "commit": "", "pr": "" },
  "enabledPlugins": { "dynamo@dynamo": true },
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git rev-list --count *)",
      "Bash(git ls-remote --heads origin *)",
      "Bash(git worktree list)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b ticket/*)",
      "Bash(git checkout release/*)",
      "Bash(git cherry-pick release/*..ticket/*)",
      "Bash(git merge --no-ff ticket/*)",
      "Bash(git merge --abort)",
      "Bash(git revert -m 1 --no-edit HEAD)",
      "Bash(git stash push -u -m *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit * --add-label in-release)",
      "Bash(gh project item-list <boardNumber> --owner <boardOwner> *)",
      "Bash(gh project field-list <boardNumber> --owner <boardOwner> *)",
      "Bash(gh project item-edit <boardNumber> --owner <boardOwner> --url https://github.com/<repo>/issues/* --field \"Status\" --value *)",
      "Bash(gh project item-edit --id * --project-id <boardId> --field-id <statusFieldId> --single-select-option-id *)",
      "Bash(gh api graphql *)",
      "Bash(gh api repos/<repo>/issues/*)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(git branch -d *)"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git checkout <mainBranch>*)",
      "Bash(git switch <mainBranch>*)",
      "Bash(git merge <mainBranch>*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue delete*)",
      "Bash(rm -rf*)",
      "Bash(gh api -X *)",
      "Bash(gh api --method *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(git push*--no-verify*)",
      "Bash(git config*)",
      "Edit(/.githooks/**)",
      "Edit(/.git/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git branch -D*)"
    ]
  }
}
