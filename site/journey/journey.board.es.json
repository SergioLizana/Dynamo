{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Un ticket por las ocho columnas del tablero",
    "locale": "es",
    "output": "site/journey/journey.board.es.html",
    "quality_profile": "showcase"
  },
  "mainPath": [
    "backlog",
    "todo",
    "build",
    "verify",
    "review",
    "merge"
  ],
  "states": [
    {
      "id": "backlog",
      "type": "start",
      "label": "Backlog",
      "sublabel": "aparcado"
    },
    {
      "id": "todo",
      "type": "waiting",
      "label": "Todo",
      "sublabel": "en cola"
    },
    {
      "id": "build",
      "type": "active",
      "label": "Build",
      "sublabel": "Builder"
    },
    {
      "id": "verify",
      "type": "decision",
      "label": "Verify",
      "sublabel": "checks"
    },
    {
      "id": "review",
      "type": "decision",
      "label": "Review",
      "sublabel": "Reviewer"
    },
    {
      "id": "merge",
      "type": "active",
      "label": "Merge",
      "sublabel": "release"
    },
    {
      "id": "done",
      "type": "success",
      "label": "Done",
      "sublabel": "fusionado"
    },
    {
      "id": "needs-human",
      "type": "failure",
      "label": "Needs Human",
      "sublabel": "parado"
    }
  ],
  "transitions": [
    {
      "id": "backlog-todo",
      "from": "backlog",
      "to": "todo",
      "label": "listo"
    },
    {
      "id": "todo-build",
      "from": "todo",
      "to": "build",
      "label": "run"
    },
    {
      "id": "build-verify",
      "from": "build",
      "to": "verify",
      "label": "hecho"
    },
    {
      "id": "verify-review",
      "from": "verify",
      "to": "review",
      "label": "ok"
    },
    {
      "id": "review-merge",
      "from": "review",
      "to": "merge",
      "label": "PASS"
    },
    {
      "id": "merge-done",
      "from": "merge",
      "to": "done",
      "label": "ok"
    },
    {
      "id": "verify-build",
      "from": "verify",
      "to": "build",
      "label": "falla",
      "variant": "dashed"
    },
    {
      "id": "review-build",
      "from": "review",
      "to": "build",
      "label": "FAIL",
      "variant": "dashed"
    },
    {
      "id": "build-needs-human",
      "from": "build",
      "to": "needs-human",
      "label": "duda",
      "variant": "security"
    },
    {
      "id": "verify-needs-human",
      "from": "verify",
      "to": "needs-human",
      "label": "sin ronda",
      "variant": "security"
    },
    {
      "id": "needs-human-todo",
      "from": "needs-human",
      "to": "todo",
      "label": "respuesta",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "El camino",
      "items": [
        "Un programa mueve cada tarjeta; ningún agente lo hace",
        "Como máximo dos rondas de Build por ticket"
      ]
    },
    {
      "dot": "rose",
      "title": "Las paradas",
      "items": [
        "Needs Human guarda un comentario, la rama y la copia",
        "Respondes, mueves la tarjeta a Todo y lo lanzas otra vez"
      ]
    }
  ]
}
