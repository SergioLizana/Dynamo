{
  "worktree": { "baseRef": "head" },
  "permissions": {
    "allow": [
      "Edit(/**)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git -C */.claude/worktrees/* status*)",
      "Bash(git -C */.claude/worktrees/* diff*)",
      "Bash(git -C */.claude/worktrees/* log*)",
      "Bash(git -C */.claude/worktrees/* show*)",
      "Bash(git -C */.claude/worktrees/* rev-parse *)",
      "Bash(git -C */.claude/worktrees/* merge-base *)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git rev-list --count *)",
      "Bash(git ls-remote --heads origin *)",
      "Bash(git worktree list)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b ticket/*)",
      "Bash(git checkout release/*)",
      "Bash(git cherry-pick release/*..ticket/*)",
      "Bash(git merge --no-ff ticket/*)",
      "Bash(git merge --abort)",
      "Bash(git revert -m 1 --no-edit HEAD)",
      "Bash(git stash push -u -m *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit * --add-label in-release)",
      "Bash(gh project item-list 1 --owner SergioLizana *)",
      "Bash(gh project field-list 1 --owner SergioLizana *)",
      "Bash(gh project item-edit 1 --owner SergioLizana --url https://github.com/SergioLizana/Dynamo/issues/* --field \"Status\" --value *)",
      "Bash(gh project item-edit --id * --project-id PVT_kwHOAbB1zs4BoyYk --field-id PVTSSF_lAHOAbB1zs4BoyYkzhnQ1FA --single-select-option-id *)",
      "Bash(gh api graphql *)",
      "Bash(gh api repos/SergioLizana/Dynamo/issues/*)",
      "Bash(claude plugin validate *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(sh -c 'cd * && git rev-parse --show-toplevel')",
      "Bash(sh -c 'cd * && claude plugin validate . --strict')",
      "Bash(sh -c 'cd * && git diff --check *')",
      "Bash(sh -c 'test -z \"$(git status --porcelain --untracked-files=no)\" && test \"$(git branch --show-current)\" = \"release/*\"')",
      "Bash(sh -c 'git worktree remove --force * || true')",
      "Bash(sh -c 'printf %s * | base64 --decode | gh issue comment * -R SergioLizana/Dynamo --body-file -')",
      "Bash(sh -c 'printf %s * | base64 --decode | { mkdir -p .claude/worktrees; cat > .claude/worktrees/release-report-*.md; }')",
      "Bash(sh -c 'out=$(cat .claude/factory.json 2>&1); code=$?; printf %s \"$out\" | base64; exit $code')",
      "Bash(sh -c 'out=$(cat .claude/worktrees/release-report-*.md 2>&1); code=$?; printf %s \"$out\" | base64; exit $code')",
      "Bash(sh -c 'out=$(git log --first-parent --format=%p%x09%s main..release/* 2>&1); code=$?; printf %s \"$out\" | base64; exit $code')",
      "Bash(sh -c 'out=$(gh api graphql -f query=* 2>&1); code=$?; printf %s \"$out\" | base64; exit $code')",
      "Bash(sh -c 'out=$(gh project item-list 1 --owner SergioLizana --format json --limit 200 --jq * 2>&1); code=$?; printf %s \"$out\" | base64; exit $code')",
      "Bash(sh -c 'out=$(gh pr list -R SergioLizana/Dynamo --head release/* --base main --state open --json number,url,body 2>&1); code=$?; printf %s \"$out\" | base64; exit $code')",
      "Bash(sh -c 'out=$(gh issue view * -R SergioLizana/Dynamo --json comments --jq * 2>&1); code=$?; printf %s \"$out\" | base64; exit $code')"
    ],
    "deny": [
      "Bash(git reset --hard*)",
      "Bash(git checkout main*)",
      "Bash(git switch main*)",
      "Bash(git merge main*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue delete*)",
      "Bash(rm -rf*)",
      "Bash(gh api -X *)",
      "Bash(gh api --method *)",
      "Bash(gh api * -X *)",
      "Bash(gh api * --method *)",
      "Bash(git push*--no-verify*)",
      "Bash(git config*)",
      "Edit(/.githooks/**)",
      "Edit(/.git/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)"
    ]
  }
}
