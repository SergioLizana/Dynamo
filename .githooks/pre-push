#!/bin/sh
# Refuses any push that updates the main branch of this project.
# git gives this hook "<local ref> <local sha> <remote ref> <remote sha>" per line on stdin, so it sees the
# exact remote ref whatever way the command was written (HEAD:refs/heads/main, sh -c, an alias).
# Enable once per clone: git config core.hooksPath .githooks

root=$(git rev-parse --show-toplevel 2>/dev/null) || root=.
main=$(sed -n 's/.*"mainBranch"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$root/.claude/factory.json" 2>/dev/null | head -n 1)
# If factory.json cannot be read, protect the default name rather than nothing.
[ -n "$main" ] || main=main

refused=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/$main" ]; then
    echo "pre-push: refused, '$remote_ref' is the main branch ($main)." >&2
    refused=1
  fi
done

if [ "$refused" -ne 0 ]; then
  echo "pre-push: nothing reaches $main from this clone. Push a release branch and merge its pull request on GitHub." >&2
  exit 1
fi
exit 0
